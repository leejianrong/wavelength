#!/usr/bin/env bash
# Mirrors CI's cheap jobs: lint + typecheck + the no-infra unit test layer.
# Install once per clone: git config core.hooksPath .githooks && chmod +x .githooks/pre-push
# Scoped exception when you've already verified the failure is unrelated: git push --no-verify
set -euo pipefail

echo "pre-push: ruff"
uv run ruff check .

echo "pre-push: mypy"
uv run mypy src

echo "pre-push: unit tests"
uv run pytest tests/unit -q
